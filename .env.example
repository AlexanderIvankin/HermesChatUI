# Путь к домашней папке Hermes
HERMES_HOME=/home/hermes/.hermes
# Адрес Hermes API (тот, что слушает 8642)
HERMES_API_URL=http://127.0.0.1:8642
# Ключ читается из $HERMES_HOME/.env (API_SERVER_KEY=...) — здесь можно переопределить
API_SERVER_KEY=

# Порт веб-приложения
PORT=8000
HOST=0.0.0.0

# HTTPS-сертификаты (нужны для работы микрофона в браузере)
TLS_CERT=./certs/cert.pem
TLS_KEY=./certs/key.pem